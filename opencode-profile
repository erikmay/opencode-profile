#!/usr/bin/env bash
set -euo pipefail

AUTH_DIR="${HOME}/.local/share/opencode"
AUTH_FILE="${AUTH_DIR}/auth.json"
PROFILES_DIR="${AUTH_DIR}/profiles"

# ── Colors ────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Helpers ───────────────────────────────────────────────

die() {
  printf '%b\n' "${RED}error:${RESET} $1" >&2
  exit 1
}
info() { printf '%b\n' "${CYAN}$1${RESET}"; }
success() { printf '%b\n' "${GREEN}$1${RESET}"; }
warn() { printf '%b\n' "${YELLOW}$1${RESET}"; }

ensure_profiles_dir() {
  mkdir -p "${PROFILES_DIR}"
}

# Validate profile name: alphanumeric, hyphens, underscores
validate_name() {
  local name="$1"
  if [[ -z "${name}" ]]; then
    die "profile name cannot be empty."
  fi
  if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    die "invalid profile name '${name}'. Use only letters, numbers, hyphens, and underscores."
  fi
}

profile_exists() {
  [[ -f "${PROFILES_DIR}/$1.json" ]]
}

profile_count() {
  ensure_profiles_dir
  find "${PROFILES_DIR}" -maxdepth 1 -name '*.json' -type f 2> /dev/null | wc -l | tr -d ' '
}

resolve_auth_symlink_target() {
  local target="$1"
  if [[ "${target}" == /* ]]; then
    printf '%s\n' "${target}"
  else
    printf '%s\n' "${AUTH_DIR}/${target}"
  fi
}

# Returns the active profile name, or "" if none/dangling
active_profile() {
  if [[ -L "${AUTH_FILE}" ]]; then
    local target
    target="$(readlink "${AUTH_FILE}" 2> /dev/null || true)"
    if [[ -n "${target}" ]]; then
      local resolved
      resolved="$(resolve_auth_symlink_target "${target}")"
      if [[ -f "${resolved}" ]]; then
        local filename="${resolved##*/}"
        printf '%s\n' "${filename%.json}"
        return 0
      fi
    fi
  fi
}

warn_if_opencode_running() {
  if pgrep -x opencode > /dev/null 2>&1; then
    warn "warning: opencode appears to be running. Restart it after switching."
  fi
}

# ── Commands ──────────────────────────────────────────────

cmd_make() {
  local name=""
  local set_current=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --current)
        set_current=true
        shift
        ;;
      -*) die "unknown flag '$1'. Usage: opencode-profile make <name> [--current]" ;;
      *)
        name="$1"
        shift
        ;;
    esac
  done

  [[ -z "${name}" ]] && die "usage: opencode-profile make <name> [--current]"
  validate_name "${name}"
  ensure_profiles_dir

  if profile_exists "${name}"; then
    die "profile '${name}' already exists. Delete it first or choose another name."
  fi

  if ${set_current}; then
    # Copy current auth.json into the profile
    if [[ -L "${AUTH_FILE}" ]]; then
      local current
      current="$(active_profile)"
      if [[ -n "${current}" ]]; then
        die "auth.json is already managed by profile '${current}'. To add another account, run 'opencode-profile make ${name}', then 'opencode-profile switch ${name}', restart opencode, and run /connect."
      fi
      die "auth.json is already a profile symlink. Switch to or create the target profile before running /connect."
    elif [[ -f "${AUTH_FILE}" ]]; then
      cp "${AUTH_FILE}" "${PROFILES_DIR}/${name}.json"
    else
      die "no auth.json found at ${AUTH_FILE}. Run /connect in opencode first."
    fi

    # Replace auth.json with symlink to this profile
    if [[ -f "${AUTH_FILE}" && ! -L "${AUTH_FILE}" ]]; then
      rm "${AUTH_FILE}"
    fi
    ln -sf "${PROFILES_DIR}/${name}.json" "${AUTH_FILE}"
    success "created profile '${name}' from current auth and set as active."
  else
    # Create an empty placeholder profile
    echo '{}' > "${PROFILES_DIR}/${name}.json"
    success "created empty profile '${name}'."
    info "run 'opencode-profile switch ${name}', restart opencode, then run /connect."
  fi
}

cmd_switch() {
  local name="${1:-}"
  [[ -z "${name}" ]] && die "usage: opencode-profile switch <name>"
  validate_name "${name}"

  if ! profile_exists "${name}"; then
    die "profile '${name}' does not exist. Run 'opencode-profile list' to see available profiles."
  fi

  local current
  current="$(active_profile)"
  if [[ "${current}" == "${name}" ]]; then
    info "already on profile '${name}'."
    return
  fi

  warn_if_opencode_running

  # If auth.json is a regular file (first time switching), remove it
  if [[ -f "${AUTH_FILE}" && ! -L "${AUTH_FILE}" ]]; then
    # Safety: back it up in case user forgot to save it
    local backup="${AUTH_DIR}/auth.json.backup"
    cp "${AUTH_FILE}" "${backup}"
    warn "backed up existing auth.json to ${backup}"
    rm "${AUTH_FILE}"
  fi

  ln -sf "${PROFILES_DIR}/${name}.json" "${AUTH_FILE}"
  success "switched to '${name}'. Restart opencode to apply."
}

cmd_list() {
  ensure_profiles_dir
  local profiles=()
  while IFS= read -r f; do
    f="${f##*/}"
    profiles+=("${f%.json}")
  done < <(find "${PROFILES_DIR}" -maxdepth 1 -name '*.json' -type f 2> /dev/null | sort)

  if [[ ${#profiles[@]} -eq 0 ]]; then
    info "no profiles saved yet."
    printf '\n'
    printf '%s\n' "  opencode-profile make <name> --current    save current auth as a profile"
    return
  fi

  local current
  current="$(active_profile)"

  printf '\n'
  printf '%b\n' "${BOLD}OpenAI profiles:${RESET}"
  printf '\n'
  for p in "${profiles[@]}"; do
    if [[ "${p}" == "${current}" ]]; then
      printf '%b\n' "  ${GREEN}* ${p}${RESET} ${DIM}(active)${RESET}"
    else
      printf '%s\n' "    ${p}"
    fi
  done
  printf '\n'
}

cmd_delete() {
  local name="${1:-}"
  [[ -z "${name}" ]] && die "usage: opencode-profile delete <name>"
  validate_name "${name}"

  if ! profile_exists "${name}"; then
    die "profile '${name}' does not exist."
  fi

  local count
  count="$(profile_count)"
  if [[ "${count}" -le 1 ]]; then
    die "cannot delete the last profile."
  fi

  local current
  current="$(active_profile)"
  if [[ "${current}" == "${name}" ]]; then
    die "cannot delete the active profile. Switch to another profile first."
  fi

  rm "${PROFILES_DIR}/${name}.json"
  success "deleted profile '${name}'."
}

cmd_rename() {
  local old="${1:-}"
  local new="${2:-}"
  [[ -z "${old}" || -z "${new}" ]] && die "usage: opencode-profile rename <old-name> <new-name>"
  validate_name "${old}"
  validate_name "${new}"

  if ! profile_exists "${old}"; then
    die "profile '${old}' does not exist."
  fi
  if profile_exists "${new}"; then
    die "profile '${new}' already exists."
  fi

  mv "${PROFILES_DIR}/${old}.json" "${PROFILES_DIR}/${new}.json"

  # If the renamed profile was active, update the symlink
  local current
  current="$(active_profile)"
  if [[ "${current}" == "${old}" || -z "${current}" ]]; then
    # Re-check: symlink might now be dangling after the rename
    if [[ -L "${AUTH_FILE}" ]]; then
      ln -sf "${PROFILES_DIR}/${new}.json" "${AUTH_FILE}"
    fi
  fi

  success "renamed '${old}' -> '${new}'."
}

cmd_which() {
  local current
  current="$(active_profile)"
  if [[ -n "${current}" ]]; then
    printf '%s\n' "${current}"
  elif [[ -f "${AUTH_FILE}" && ! -L "${AUTH_FILE}" ]]; then
    info "auth.json is a regular file (no profile active)."
    info "run 'opencode-profile make <name> --current' to save it as a profile."
  else
    die "no active profile found."
  fi
}

cmd_help() {
  printf '\n'
  printf '%b\n' "${BOLD}Open Code Profile${RESET} - manage OpenAI auth profiles for OpenCode"
  printf '\n'
  printf '%b\n' "${BOLD}USAGE${RESET}"
  printf '%s\n' "  opencode-profile <command> [args]"
  printf '\n'
  printf '%b\n' "${BOLD}COMMANDS${RESET}"
  printf '%s\n' "  make <name> [--current]    Save regular auth.json (--current)"
  printf '%s\n' "                             or create an empty profile for a new account"
  printf '%s\n' "  switch <name>              Switch to a different profile"
  printf '%s\n' "  list                       List all profiles"
  printf '%s\n' "  which                      Show the active profile name"
  printf '%s\n' "  rename <old> <new>         Rename a profile"
  printf '%s\n' "  delete <name>              Delete a profile (not the last or active one)"
  printf '%s\n' "  help                       Show this help"
  printf '\n'
  printf '%b\n' "${BOLD}SETUP${RESET}"
  printf '%s\n' "  1. /connect in opencode with account A"
  printf '%s\n' "  2. opencode-profile make work --current"
  printf '%s\n' "  3. opencode-profile make personal"
  printf '%s\n' "  4. opencode-profile switch personal"
  printf '%s\n' "  5. restart opencode and /connect with account B"
  printf '%s\n' "  6. opencode-profile switch work"
  printf '\n'
  printf '%b\n' "${BOLD}FILES${RESET}"
  printf '%s\n' "  ${AUTH_FILE}        (symlink to active profile)"
  printf '%s\n' "  ${PROFILES_DIR}/   (saved profiles)"
  printf '\n'
}

# ── Main ──────────────────────────────────────────────────

cmd="${1:-help}"
shift || true

case "${cmd}" in
  make) cmd_make "$@" ;;
  switch) cmd_switch "$@" ;;
  list | ls) cmd_list ;;
  delete | rm) cmd_delete "$@" ;;
  rename | mv) cmd_rename "$@" ;;
  which) cmd_which ;;
  help | --help | -h) cmd_help ;;
  *) die "unknown command '${cmd}'. Run 'opencode-profile help' for usage." ;;
esac
